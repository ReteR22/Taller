# ─────────────────────────────────────────────
# MechPro API — Variables de Entorno (ejemplo)
# Copiá este archivo como .env y completá los valores
# ─────────────────────────────────────────────

# ── Servidor ──────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Base de Datos ─────────────────────────────
# Formato: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:PASSWORD@localhost:3306/mechpro"

# ── JWT ───────────────────────────────────────
JWT_SECRET="mechpro-super-secret-key-cambiar-en-produccion-min-32chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Groq ──────────────────────────────────────
# Obtené tu key en: https://console.groq.com
GROQ_API_KEY="tu-groq-api-key-aqui"

# ── Frontend ──────────────────────────────────
FRONTEND_URL="http://localhost:5173"

# ── Upload ────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# ── Logs ──────────────────────────────────────
LOG_LEVEL="debug"
LOG_DIR="./logs"
