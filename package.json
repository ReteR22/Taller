{
  "name": "mechpro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev":         "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api":     "npm run dev -w apps/api",
    "dev:web":     "npm run dev -w apps/web",
    "build":       "npm run build -w apps/api && npm run build -w apps/web",
    "db:migrate":  "npm run db:migrate -w apps/api",
    "db:seed":     "npm run db:seed -w apps/api",
    "db:studio":   "npm run db:studio -w apps/api",
    "db:reset":    "npm run db:reset -w apps/api",
    "setup":       "npm install && npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
